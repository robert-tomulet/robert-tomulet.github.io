[Unit]
Description=Aces Robotics CMS
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/acesrobotics.dev/html
Environment="PATH=/var/www/acesrobotics.dev/html/venv/bin"
Environment="9ccbd5712483e3ac45d4dd0a06d1649e0d9f15f1f8352bb5b44ac128af51762e"
Environment="DATABASE_URL=sqlite:////var/www/acesrobotics.dev/html/instance/aces.db"
ExecStart=/var/www/acesrobotics.dev/html/venv/bin/gunicorn --workers 1 --bind unix:app.sock -m 007 wsgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
